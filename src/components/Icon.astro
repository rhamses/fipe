---
import { icons as lucide } from '@iconify-json/lucide';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
	name: string;
	size?: number | string;
	title?: string;
}

const { name, class: className, size, title, width, height, ...rest } = Astro.props;

const iconName = name.includes(':') ? name.split(':')[1]! : name;
const icon = lucide.icons[iconName];

if (!icon) {
	throw new Error(`Icon not found: ${name}`);
}

const viewBoxWidth = icon.width ?? lucide.width ?? 24;
const viewBoxHeight = icon.height ?? lucide.height ?? 24;
const resolvedSize = size ?? '1em';
const resolvedWidth = width ?? resolvedSize;
const resolvedHeight = height ?? resolvedSize;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox={`0 0 ${viewBoxWidth} ${viewBoxHeight}`}
	width={resolvedWidth}
	height={resolvedHeight}
	class={className}
	role={title ? 'img' : 'presentation'}
	aria-hidden={title ? undefined : 'true'}
	data-icon={name}
	{...rest}
>
	{title && <title>{title}</title>}
	<Fragment set:html={icon.body} />
</svg>
