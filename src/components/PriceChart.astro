---
interface Dataset {
	label: string;
	values: number[];
	color?: string;
	colors?: string[];
}

interface Props {
	id?: string;
	labels?: string[];
	values?: number[];
	label?: string;
	type?: 'line' | 'bar' | 'pie';
	horizontal?: boolean;
	zoom?: boolean;
	colorPerBar?: boolean;
	datasets?: Dataset[];
}

const {
	id = 'chart',
	labels = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun'],
	values = [42, 48, 45, 52, 58, 61],
	label = 'Valor médio',
	type = 'line',
	horizontal = false,
	zoom = false,
	colorPerBar = false,
	datasets,
} = Astro.props;

const resolvedDatasets: Dataset[] =
	datasets && datasets.length > 0 ? datasets : [{ label, values }];

const chartData = JSON.stringify({
	labels,
	type,
	horizontal,
	zoom,
	colorPerBar,
	datasets: resolvedDatasets,
});
---

<div class:list={['chart-wrap', { 'chart-wrap--pie': type === 'pie', 'chart-wrap--zoom': zoom }]}>
	<canvas id={id} data-chart={chartData} aria-label={label} role="img"></canvas>
	{zoom && <p class="zoom-hint">Scroll ou pinça para zoom · arraste para pan · duplo clique para resetar</p>}
</div>

<script>
	import {
		Chart,
		LineController,
		LineElement,
		BarController,
		BarElement,
		PieController,
		ArcElement,
		PointElement,
		LinearScale,
		CategoryScale,
		Filler,
		Tooltip,
		Legend,
	} from 'chart.js';
	import zoomPlugin from 'chartjs-plugin-zoom';

	Chart.register(
		LineController,
		LineElement,
		BarController,
		BarElement,
		PieController,
		ArcElement,
		PointElement,
		LinearScale,
		CategoryScale,
		Filler,
		Tooltip,
		Legend,
		zoomPlugin,
	);

	const VEHICLE_COLORS: Record<string, { border: string; fill: string; soft: string }> = {
		carros: {
			border: '#2F6FED',
			fill: 'rgba(47, 111, 237, 0.65)',
			soft: 'rgba(47, 111, 237, 0.18)',
		},
		motos: {
			border: '#84C344',
			fill: 'rgba(132, 195, 68, 0.65)',
			soft: 'rgba(132, 195, 68, 0.18)',
		},
		caminhoes: {
			border: '#E8B84A',
			fill: 'rgba(232, 184, 74, 0.7)',
			soft: 'rgba(232, 184, 74, 0.22)',
		},
		caminhões: {
			border: '#E8B84A',
			fill: 'rgba(232, 184, 74, 0.7)',
			soft: 'rgba(232, 184, 74, 0.22)',
		},
	};

	const PALETTE = [
		VEHICLE_COLORS.carros!,
		VEHICLE_COLORS.motos!,
		VEHICLE_COLORS.caminhoes!,
		{ border: '#7B5CFF', fill: 'rgba(123, 92, 255, 0.65)', soft: 'rgba(123, 92, 255, 0.18)' },
		{ border: '#0D9488', fill: 'rgba(13, 148, 136, 0.65)', soft: 'rgba(13, 148, 136, 0.18)' },
		{ border: '#E85D4C', fill: 'rgba(232, 93, 76, 0.65)', soft: 'rgba(232, 93, 76, 0.18)' },
		{ border: '#DB2777', fill: 'rgba(219, 39, 119, 0.65)', soft: 'rgba(219, 39, 119, 0.18)' },
		{ border: '#4B5563', fill: 'rgba(75, 85, 99, 0.6)', soft: 'rgba(75, 85, 99, 0.16)' },
	];

	const PIE_COLORS = [
		'#2F6FED',
		'#84C344',
		'#E8B84A',
		'#7B5CFF',
		'#0D9488',
		'#E85D4C',
		'#DB2777',
		'#4B5563',
	];
	const BAR_FILLS = PIE_COLORS.map((color) => {
		const r = Number.parseInt(color.slice(1, 3), 16);
		const g = Number.parseInt(color.slice(3, 5), 16);
		const b = Number.parseInt(color.slice(5, 7), 16);
		return `rgba(${r}, ${g}, ${b}, 0.65)`;
	});
	const TICK = '#5c6560';
	const GRID = 'rgba(31, 36, 32, 0.08)';
	const PIE_BORDER = '#e5e5e5';

	const normalizeLabel = (label: string) =>
		label
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.toLowerCase();

	const paletteForLabel = (label: string, index: number) => {
		const normalized = normalizeLabel(label);
		if (normalized.includes('carro')) return VEHICLE_COLORS.carros!;
		if (normalized.includes('moto')) return VEHICLE_COLORS.motos!;
		if (normalized.includes('caminh')) return VEHICLE_COLORS.caminhoes!;
		return PALETTE[index % PALETTE.length]!;
	};

	document.querySelectorAll<HTMLCanvasElement>('canvas[data-chart]').forEach((canvas) => {
		if (canvas.dataset.chartInitialized === 'true') return;

		const raw = canvas.dataset.chart;
		if (!raw) return;

		const data = JSON.parse(raw) as {
			labels: string[];
			type: 'line' | 'bar' | 'pie';
			horizontal: boolean;
			zoom: boolean;
			colorPerBar: boolean;
			datasets: Array<{
				label: string;
				values: number[];
				color?: string;
				colors?: string[];
			}>;
		};

		const isBar = data.type === 'bar';
		const isPie = data.type === 'pie';

		new Chart(canvas, {
			type: data.type ?? 'line',
			data: {
				labels: data.labels,
				datasets: data.datasets.map((dataset, index) => {
					const palette = paletteForLabel(dataset.label, index);

					if (isPie) {
						return {
							label: dataset.label,
							data: dataset.values,
							backgroundColor: dataset.colors ?? PIE_COLORS,
							borderColor: PIE_BORDER,
							borderWidth: 2,
						};
					}

					const usePerBar =
						isBar &&
						(data.colorPerBar || Boolean(dataset.colors?.length)) &&
						data.datasets.length === 1;

					const barColors =
						dataset.colors ??
						dataset.values.map((_, valueIndex) => BAR_FILLS[valueIndex % BAR_FILLS.length]!);

					return {
						label: dataset.label,
						data: dataset.values,
						borderColor: usePerBar
							? dataset.values.map(
									(_, valueIndex) => PALETTE[valueIndex % PALETTE.length]!.border,
								)
							: (dataset.color ?? palette.border),
						backgroundColor: isBar
							? usePerBar
								? barColors
								: (dataset.color ?? palette.fill)
							: palette.soft,
						fill: !isBar,
						tension: 0.35,
						pointRadius: isBar ? 0 : 3,
						pointHoverRadius: isBar ? 0 : 5,
						borderWidth: isBar ? 0 : 2,
					};
				}),
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				indexAxis: isBar && data.horizontal ? 'y' : 'x',
				plugins: {
					legend: {
						position: isPie ? 'bottom' : 'top',
						labels: { color: TICK },
					},
					tooltip: isPie
						? {
								callbacks: {
									label(context) {
										const value = Number(context.raw ?? 0);
										const total = context.dataset.data.reduce(
											(sum: number, item) => sum + Number(item ?? 0),
											0,
										);
										const pct = total > 0 ? (value / total) * 100 : 0;
										return `${context.label}: ${pct.toFixed(1)}%`;
									},
								},
							}
						: undefined,
					zoom: data.zoom
						? {
								limits: {
									x: { min: 'original', max: 'original' },
									y: { min: 'original', max: 'original' },
								},
								pan: {
									enabled: true,
									mode: 'x',
								},
								zoom: {
									wheel: { enabled: true },
									pinch: { enabled: true },
									mode: 'x',
								},
							}
						: undefined,
				},
				scales: isPie
					? undefined
					: {
							x: {
								ticks: { color: TICK },
								grid: { color: GRID },
							},
							y: {
								ticks: { color: TICK },
								grid: { color: GRID },
							},
						},
			},
		});

		canvas.dataset.chartInitialized = 'true';
	});
</script>

<style>
	.chart-wrap {
		position: relative;
		width: 100%;
		height: 240px;
	}

	.chart-wrap--pie {
		height: 280px;
	}

	.chart-wrap--zoom {
		height: 320px;
	}

	.zoom-hint {
		margin: 0.5rem 0 0;
		color: var(--muted, #5c6560);
		font-size: 0.75rem;
	}
</style>
