---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="FIPE LP — Consulta de preços">
	<main class="page">
		<header class="hero">
			<h1>Consulta de preços FIPE</h1>
			<p class="lede">Busque marca, modelo e ano.</p>
		</header>

		<section
			class="search-panel"
			aria-label="Busca FIPE"
			x-data="{
				q: '',
				results: [],
				loading: false,
				open: false,
				selected: null,
				history: null,
				historyLoading: false,
				historyError: null,
				controller: null,
				historyController: null,
				async search() {
					const query = this.q.trim();
					this.open = true;
					if (query.length < 2) {
						this.results = [];
						this.loading = false;
						return;
					}
					this.loading = true;
					if (this.controller) this.controller.abort();
					this.controller = new AbortController();
					try {
						const response = await fetch(
							`/api/autocomplete?q=${encodeURIComponent(query)}&limit=12`,
							{ signal: this.controller.signal },
						);
						const data = await response.json();
						if (!response.ok) throw new Error(data.error || 'Falha na busca');
						this.results = data.results || [];
					} catch (error) {
						if (error?.name !== 'AbortError') {
							this.results = [];
						}
					} finally {
						this.loading = false;
					}
				},
				cleanLabel(label) {
					return String(label || '')
						.replace(/\s*\([^)]*\)\s*$/, '')
						.trim();
				},
				async choose(item) {
					const cleaned = { ...item, label: this.cleanLabel(item.label) };
					this.selected = cleaned;
					this.q = cleaned.label;
					this.open = false;
					this.history = null;
					this.historyError = null;
					this.historyLoading = true;
					if (this.historyController) this.historyController.abort();
					this.historyController = new AbortController();
					try {
						const params = new URLSearchParams({
							brand: cleaned.brand,
							model: cleaned.model,
							version: cleaned.version || '',
							year: String(cleaned.year),
							vehicleId: String(cleaned.vehicleId),
						});
						const response = await fetch(`/api/vehicle-history?${params}`, {
							signal: this.historyController.signal,
						});
						const data = await response.json();
						if (!response.ok) throw new Error(data.error || 'Falha ao carregar histórico');
						this.history = data;
						this.historyLoading = false;
						await this.$nextTick();
						requestAnimationFrame(() => {
							requestAnimationFrame(() => {
								window.renderVehiclePriceChart?.(
									this.$refs.priceChart,
									data.labels || [],
									data.values || [],
									data.vehicleId,
								);
								window.renderVehicleForecastChart?.(
									this.$refs.forecastChart,
									data.forecast?.labels || [],
									data.forecast?.values || [],
									data.vehicleId,
								);
								window.renderVehicleFromZeroChart?.(
									this.$refs.fromZeroChart,
									data.fromZeroKm?.points || [],
									data.vehicleId,
								);
							});
						});
					} catch (error) {
						if (error?.name === 'AbortError') return;
						this.historyError = error?.message || 'Não foi possível carregar o gráfico.';
						this.history = null;
						this.historyLoading = false;
					}
				},
				formatCurrency(value) {
					if (value == null) return '—';
					return new Intl.NumberFormat('pt-BR', {
						style: 'currency',
						currency: 'BRL',
						maximumFractionDigits: 0,
					}).format(value);
				},
				formatPct(value) {
					if (value == null) return '—';
					const num = Number(value);
					const sign = num > 0 ? '+' : '';
					return `${sign}${num.toLocaleString('pt-BR', { maximumFractionDigits: 1 })}%`;
				}
			}"
			@click.outside="open = false"
		>
			<label class="search-label" for="search">Buscar veículo</label>
			<div class="search-field">
				<div class="search-shell">
					<Icon name="lucide:search" class="search-icon" />
					<input
						id="search"
						name="search"
						type="search"
						class="search-input"
						placeholder="Marca, modelo, ano… ex: Fiat Uno 2018"
						autocomplete="off"
						autocapitalize="off"
						spellcheck="false"
						x-model="q"
						@input.debounce.250ms="search()"
						@focus="open = q.trim().length >= 2"
						@keydown.escape="open = false"
					/>
					<span class="search-status" x-show="loading" x-cloak>Buscando…</span>
				</div>
				<ul class="search-results" x-show="open && results.length > 0" x-cloak role="listbox">
					<template x-for="item in results" :key="`${item.brand}-${item.model}-${item.year}-${item.version}`">
						<li>
							<button type="button" class="search-result" @click="choose(item)">
								<span class="search-result-label" x-text="cleanLabel(item.label)"></span>
								<span
									class="search-result-meta"
									x-text="item.vehicleId === 1 ? 'Carros' : item.vehicleId === 2 ? 'Motos' : 'Caminhões'"
								></span>
							</button>
						</li>
					</template>
				</ul>
				<p class="search-empty" x-show="open && !loading && q.trim().length >= 2 && results.length === 0" x-cloak>
					Nenhum resultado para “<span x-text="q.trim()"></span>”.
				</p>
			</div>

			<div class="value-cards" x-show="selected" x-cloak>
				<article class="value-card" aria-live="polite">
					<p class="value-card-vehicle" x-text="history?.title || 'Valor —'"></p>
					<p class="value-card-price" x-show="history?.latestPrice != null" x-cloak>
						<strong x-text="formatCurrency(history?.latestPrice)"></strong>
						<span x-text="history?.vehicleLabel"></span>
					</p>
					<p class="value-card-status" x-show="historyLoading" x-cloak>Carregando histórico…</p>
					<p class="value-card-status value-card-status--error" x-show="historyError" x-cloak x-text="historyError"></p>
				</article>
				<article
					class="value-card"
					x-show="historyLoading || history?.fromZeroKm?.price0km != null"
					aria-label="Valor Zero KM"
				>
					<p class="value-card-vehicle">Valor Zero KM</p>
					<p class="value-card-price" x-show="history?.fromZeroKm?.price0km != null" x-cloak>
						<strong x-text="formatCurrency(history?.fromZeroKm?.price0km)"></strong>
						<span x-text="history?.fromZeroKm?.startLabel"></span>
					</p>
					<p class="value-card-status" x-show="historyLoading" x-cloak>Carregando valor 0km…</p>
				</article>
			</div>

			<article
				class="chart-card"
				x-show="selected && (historyLoading || historyError || (history && history.values && history.values.length > 0) || (history && history.values && history.values.length === 0))"
				x-cloak
				aria-label="Histórico de preço"
			>
				<div class="demo-head">
					<Icon name="lucide:chart-line" />
					<h2>Últimos 12 meses</h2>
				</div>
				<p class="value-card-status" x-show="historyLoading" x-cloak>Carregando gráfico…</p>
				<p class="value-card-status value-card-status--error" x-show="historyError" x-cloak x-text="historyError"></p>
				<div x-show="history && !historyLoading && !historyError && history.values?.length > 0" x-cloak>
					<div class="chart-wrap chart-wrap--vehicle">
						<canvas x-ref="priceChart" aria-label="Histórico de preço" role="img"></canvas>
					</div>
				</div>
				<p
					class="value-card-status"
					x-show="history && !historyLoading && !historyError && (!history.values || history.values.length === 0)"
					x-cloak
				>
					Sem preços registrados nos últimos 12 meses.
				</p>
			</article>

			<article
				class="chart-card"
				x-show="selected && (historyLoading || (history && history.forecast))"
				x-cloak
				aria-label="Previsão de preço"
			>
				<div class="demo-head">
					<Icon name="lucide:trending-down" />
					<h2>Previsão para os próximos 12 meses</h2>
				</div>
				<p class="value-card-status" x-show="historyLoading" x-cloak>Calculando previsão…</p>
				<div
					x-show="history && !historyLoading && history.forecast && history.forecast.values?.length > 0"
					x-cloak
				>
					<p class="forecast-meta">
						<span
							x-show="history?.forecast?.expectedChangePct != null"
							x-text="((history?.forecast?.expectedChangePct ?? 0) > 0 ? '+' : '') + (history?.forecast?.expectedChangePct ?? 0) + '% em 12 meses'"
						></span>
						<span x-text="history?.forecast?.note"></span>
					</p>
					<div class="chart-wrap chart-wrap--vehicle">
						<canvas x-ref="forecastChart" aria-label="Previsão de depreciação" role="img"></canvas>
					</div>
				</div>
				<p
					class="value-card-status"
					x-show="history && !historyLoading && !history.forecast"
					x-cloak
				>
					Não foi possível estimar a previsão para este veículo.
				</p>
			</article>

			<article
				class="chart-card"
				x-show="selected && (historyLoading || historyError || history)"
				x-cloak
				aria-label="Do zero km até hoje"
			>
				<div class="demo-head">
					<Icon name="lucide:timer" />
					<h2>Do zero km até hoje</h2>
				</div>
				<p class="value-card-status" x-show="historyLoading" x-cloak>Carregando gráfico…</p>
				<p class="value-card-status value-card-status--error" x-show="historyError" x-cloak x-text="historyError"></p>
				<div
					x-show="history && !historyLoading && !historyError && history.fromZeroKm && history.fromZeroKm.points?.length > 1"
					x-cloak
				>
					<p class="forecast-meta">
						<span
							x-show="history?.fromZeroKm?.latestChangePct != null"
							x-text="formatPct(history?.fromZeroKm?.latestChangePct) + ' desde o 0km'"
						></span>
						<span
							x-text="'Preço 0km em ' + (history?.fromZeroKm?.startLabel || '—') + ': ' + formatCurrency(history?.fromZeroKm?.price0km)"
						></span>
					</p>
					<div class="chart-wrap chart-wrap--vehicle">
						<canvas x-ref="fromZeroChart" aria-label="Variação percentual desde o 0km" role="img"></canvas>
					</div>
				</div>
				<p
					class="value-card-status"
					x-show="history && !historyLoading && !historyError && !history.fromZeroKm"
					x-cloak
				>
					Não há série 0km até hoje para este veículo.
				</p>
			</article>
		</section>
	</main>
</Layout>

<script>
	import {
		Chart,
		LineController,
		LineElement,
		PointElement,
		LinearScale,
		CategoryScale,
		Filler,
		Tooltip,
		Legend,
	} from 'chart.js';

	Chart.register(
		LineController,
		LineElement,
		PointElement,
		LinearScale,
		CategoryScale,
		Filler,
		Tooltip,
		Legend,
	);

	const VEHICLE_COLORS = {
		1: { border: '#2F6FED', soft: 'rgba(47, 111, 237, 0.18)' },
		2: { border: '#84C344', soft: 'rgba(132, 195, 68, 0.18)' },
		3: { border: '#E8B84A', soft: 'rgba(232, 184, 74, 0.22)' },
	};

	/** @type {import('chart.js').Chart | null} */
	let activeChart = null;
	/** @type {import('chart.js').Chart | null} */
	let forecastChart = null;
	/** @type {import('chart.js').Chart | null} */
	let fromZeroChart = null;

	const xCrosshair = {
		id: 'xCrosshair',
		afterDraw(chart) {
			const active = chart.tooltip?.getActiveElements?.() ?? [];
			if (active.length === 0) return;
			const x = active[0]?.element?.x;
			if (!Number.isFinite(x)) return;
			const { top, bottom } = chart.chartArea;
			const { ctx } = chart;
			ctx.save();
			ctx.beginPath();
			ctx.setLineDash([4, 4]);
			ctx.lineWidth = 1;
			ctx.strokeStyle = 'rgba(31, 36, 32, 0.28)';
			ctx.moveTo(x, top);
			ctx.lineTo(x, bottom);
			ctx.stroke();
			ctx.restore();
		},
	};

	/**
	 * @param {HTMLCanvasElement | undefined} canvas
	 * @param {string[]} labels
	 * @param {number[]} values
	 * @param {number} [vehicleId]
	 * @param {{ dashed?: boolean, label?: string }} [opts]
	 */
	const renderLineChart = (canvas, labels, values, vehicleId = 1, opts = {}) => {
		if (!canvas) return null;
		if (!labels.length || !values.length) return null;

		const palette = VEHICLE_COLORS[vehicleId] ?? VEHICLE_COLORS[1];
		const chart = new Chart(canvas, {
			type: 'line',
			data: {
				labels,
				datasets: [
					{
						label: opts.label || 'Preço FIPE',
						data: values,
						borderColor: palette.border,
						backgroundColor: palette.soft,
						fill: true,
						tension: 0.35,
						pointRadius: 4,
						pointHoverRadius: 7,
						pointHitRadius: 18,
						borderWidth: 2,
						borderDash: opts.dashed ? [6, 4] : undefined,
					},
				],
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				animation: false,
				interaction: {
					mode: 'index',
					intersect: false,
				},
				plugins: {
					legend: { display: false },
					tooltip: {
						intersect: false,
						mode: 'index',
						callbacks: {
							label(context) {
								const value = Number(context.raw ?? 0);
								return new Intl.NumberFormat('pt-BR', {
									style: 'currency',
									currency: 'BRL',
									maximumFractionDigits: 0,
								}).format(value);
							},
						},
					},
				},
				scales: {
					x: {
						ticks: { color: '#5c6560' },
						grid: { color: 'rgba(31, 36, 32, 0.08)' },
					},
					y: {
						ticks: {
							color: '#5c6560',
							callback(value) {
								return new Intl.NumberFormat('pt-BR', {
									style: 'currency',
									currency: 'BRL',
									notation: 'compact',
									maximumFractionDigits: 1,
								}).format(Number(value));
							},
						},
						grid: { color: 'rgba(31, 36, 32, 0.08)' },
					},
				},
			},
		});
		chart.resize();
		return chart;
	};

	/**
	 * @param {HTMLCanvasElement | undefined} canvas
	 * @param {string[]} labels
	 * @param {number[]} values
	 * @param {number} [vehicleId]
	 */
	window.renderVehiclePriceChart = (canvas, labels, values, vehicleId = 1) => {
		activeChart?.destroy();
		activeChart = renderLineChart(canvas, labels, values, vehicleId, {
			label: 'Preço FIPE',
		});
	};

	/**
	 * @param {HTMLCanvasElement | undefined} canvas
	 * @param {string[]} labels
	 * @param {number[]} values
	 * @param {number} [vehicleId]
	 */
	window.renderVehicleForecastChart = (canvas, labels, values, vehicleId = 1) => {
		forecastChart?.destroy();
		forecastChart = renderLineChart(canvas, labels, values, vehicleId, {
			label: 'Valor estimado',
			dashed: true,
		});
	};

	/**
	 * @param {HTMLCanvasElement | undefined} canvas
	 * @param {Array<{ months: number, pct: number, price?: number, label?: string }>} points
	 * @param {number} [vehicleId]
	 */
	window.renderVehicleFromZeroChart = (canvas, points, vehicleId = 1) => {
		fromZeroChart?.destroy();
		fromZeroChart = null;
		if (!canvas || !points?.length) return;

		const palette = VEHICLE_COLORS[vehicleId] ?? VEHICLE_COLORS[1];
		const data = points
			.filter((point) => Number.isFinite(point.months) && Number.isFinite(point.pct))
			.map((point) => ({
				x: Number(point.months),
				y: Number(point.pct),
				price: point.price,
				period: point.label,
			}));
		if (data.length === 0) return;

		const dense = data.length > 36;

		fromZeroChart = new Chart(canvas, {
			type: 'line',
			plugins: [xCrosshair],
			data: {
				datasets: [
					{
						label: 'Variação desde o 0km',
						data,
						borderColor: palette.border,
						backgroundColor: palette.soft,
						fill: true,
						tension: 0.35,
						pointRadius: dense ? 0 : 3,
						pointHoverRadius: 6,
						pointHitRadius: 24,
						borderWidth: 2.5,
					},
				],
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				animation: false,
				interaction: {
					mode: 'nearest',
					intersect: false,
					axis: 'x',
				},
				plugins: {
					legend: { display: false },
					tooltip: {
						intersect: false,
						mode: 'nearest',
						axis: 'x',
						displayColors: false,
						callbacks: {
							title(items) {
								const months = Number(items[0]?.parsed?.x ?? 0);
								const raw = items[0]?.raw;
								const period =
									raw && typeof raw === 'object' && 'period' in raw && raw.period
										? String(raw.period)
										: '';
								const monthLabel = `${months} ${months === 1 ? 'mês' : 'meses'}`;
								return period ? `${monthLabel} · ${period}` : monthLabel;
							},
							label(context) {
								const raw = context.raw;
								const value = Number(context.parsed?.y ?? 0);
								const sign = value > 0 ? '+' : '';
								const pct = `${sign}${value.toLocaleString('pt-BR', { maximumFractionDigits: 1 })}%`;
								const price =
									raw && typeof raw === 'object' && 'price' in raw && raw.price != null
										? new Intl.NumberFormat('pt-BR', {
												style: 'currency',
												currency: 'BRL',
												maximumFractionDigits: 0,
											}).format(Number(raw.price))
										: '';
								return price ? `${pct} · ${price}` : pct;
							},
						},
					},
				},
				scales: {
					x: {
						type: 'linear',
						min: 0,
						title: {
							display: true,
							text: 'Meses',
							color: '#5c6560',
							font: { size: 11, weight: 600 },
						},
						ticks: {
							color: '#5c6560',
							stepSize: 12,
							callback(value) {
								if (Number(value) % 12 !== 0) return '';
								return Number(value);
							},
						},
						grid: { color: 'rgba(31, 36, 32, 0.08)' },
					},
					y: {
						title: {
							display: true,
							text: 'Variação %',
							color: '#5c6560',
							font: { size: 11, weight: 600 },
						},
						ticks: {
							color: '#5c6560',
							callback(value) {
								const num = Number(value);
								const sign = num > 0 ? '+' : '';
								return `${sign}${num}%`;
							},
						},
						grid: { color: 'rgba(31, 36, 32, 0.08)' },
					},
				},
			},
		});
		fromZeroChart.resize();
	};
</script>

<style>
	.page {
		width: 100%;
		max-width: 100%;
		margin: 0;
		padding: 2rem 1.25rem 3rem;
		box-sizing: border-box;
	}

	.hero {
		margin-bottom: 1.75rem;
	}

	h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	.lede {
		margin: 0;
		max-width: 40rem;
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.5;
	}

	.search-panel {
		position: relative;
		width: 100%;
		max-width: 100%;
	}

	.search-label {
		display: block;
		margin-bottom: 0.45rem;
		color: var(--muted);
		font-size: 0.85rem;
		font-weight: 600;
	}

	.search-field {
		position: relative;
		z-index: 30;
		width: 100%;
	}

	.search-shell {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
	}

	.search-icon {
		position: absolute;
		left: 1rem;
		width: 1.5rem;
		height: 1.5rem;
		color: var(--accent-deep);
		pointer-events: none;
	}

	.search-input {
		width: 100%;
		padding: 1rem 6rem 1rem 3.25rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--surface-raised);
		color: var(--text);
		font: inherit;
		font-size: 1.5rem;
		line-height: 1.25;
		outline: none;
	}

	.search-input:focus {
		border-color: var(--accent-deep);
		box-shadow: 0 0 0 3px var(--accent-soft);
	}

	.search-status {
		position: absolute;
		right: 0.9rem;
		color: var(--muted);
		font-size: 0.8rem;
	}

	.search-results {
		position: absolute;
		z-index: 40;
		top: calc(100% + 0.35rem);
		right: 0;
		left: 0;
		margin: 0;
		padding: 0.35rem;
		list-style: none;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--surface-raised);
		box-shadow: 0 12px 28px rgba(31, 36, 32, 0.12);
		max-height: 20rem;
		overflow: auto;
	}

	.search-result {
		display: grid;
		gap: 0.15rem;
		width: 100%;
		padding: 0.7rem 0.75rem;
		border: 0;
		border-radius: 8px;
		background: transparent;
		color: inherit;
		text-align: left;
	}

	.search-result:hover,
	.search-result:focus-visible {
		background: var(--accent-soft);
		outline: none;
	}

	.search-result-label {
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.search-result-meta {
		color: var(--muted);
		font-size: 0.78rem;
	}

	.search-empty {
		margin: 0.65rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
	}

	.value-cards {
		display: grid;
		grid-template-columns: 1fr;
