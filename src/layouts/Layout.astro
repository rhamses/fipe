---
import htmxUrl from 'htmx.org/dist/htmx.min.js?url';
import Icon from '../components/Icon.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'FIPE LP',
	description = 'Consulta de preços FIPE: busque marca, modelo e ano com histórico e previsão.',
} = Astro.props;

const path = Astro.url.pathname;
const isHome = path === '/' || path === '/index.html';
const isStats = path.startsWith('/stats');

/** Defina PUBLIC_SITE_URL no .env para URLs absolutas de OG (ex: https://seu-dominio.com). */
const siteUrl = String(import.meta.env.PUBLIC_SITE_URL || Astro.site || '')
	.trim()
	.replace(/\/$/, '');
const canonicalPath = path === '/index.html' ? '/' : path;
const pageUrl = siteUrl ? `${siteUrl}${canonicalPath}` : canonicalPath;
const ogImage = siteUrl ? `${siteUrl}/og-image.png` : '/og-image.png';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#84C344" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content="FIPE LP" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="FIPE LP — Consulta de preços FIPE" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline src={htmxUrl}></script>
	</head>
	<body>
		<div class="shell">
			<header class="site-header">
				<a class="site-brand" href="/">
					<Icon name="lucide:car" class="site-brand-icon" />
					<span>FIPE LP</span>
				</a>
				<nav class="site-nav" aria-label="Navegação principal">
					<a href="/" class:list={[{ active: isHome }]}>Consulta</a>
					<a href="/stats" class:list={[{ active: isStats }]}>Stats</a>
				</nav>
			</header>

			<slot />

			<footer class="site-footer">
				<a
					class="site-footer-link"
					href="https://amb1.io"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="amb1.io — abrir site"
				>
					<img class="site-footer-logo" src="/amb1.png" alt="amb1.io" width="30" height="30" />
				</a>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--bg: #e5e5e5;
		--surface: #f4f4f4;
		--surface-raised: #ffffff;
		--text: #1f2420;
		--muted: #5c6560;
		--accent: #bdd747;
		--accent-deep: #84c344;
		--accent-soft: rgba(189, 215, 71, 0.28);
		--border: rgba(31, 36, 32, 0.12);
		--ok: #84c344;
		--font: 'Segoe UI', system-ui, sans-serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
		font-family: var(--font);
		background:
			radial-gradient(ellipse 90% 55% at 15% -10%, rgba(132, 195, 68, 0.35), transparent 55%),
			radial-gradient(ellipse 70% 45% at 90% 0%, rgba(189, 215, 71, 0.28), transparent 50%),
			linear-gradient(180deg, #f0f3e8 0%, var(--bg) 42%, #dedede 100%);
		color: var(--text);
	}

	a {
		color: var(--accent-deep);
	}

	button {
		font: inherit;
		cursor: pointer;
	}

	.shell {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100dvh;
	}

	.shell > main.page {
		flex: 1;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		box-sizing: border-box;
		height: 50px;
		padding: 0 1.25rem;
		border-bottom: 1px solid var(--border);
		background: color-mix(in srgb, var(--surface-raised) 88%, transparent);
		backdrop-filter: blur(10px);
	}

	.site-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.site-brand:hover {
		color: var(--accent-deep);
	}

	.site-brand-icon {
		width: 1.35rem;
		height: 1.35rem;
		color: var(--accent-deep);
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.site-nav a {
		padding: 0.4rem 0.7rem;
		border-radius: 8px;
		color: var(--muted);
		font-size: 0.92rem;
		font-weight: 600;
		text-decoration: none;
	}

	.site-nav a:hover {
		color: var(--text);
		background: var(--accent-soft);
	}

	.site-nav a.active {
		color: var(--text);
		background: var(--accent-soft);
	}

	.site-footer {
		display: flex;
		justify-content: center;
		padding: 0.95rem 1.25rem 1.1rem;
		border-top: 1px solid var(--border);
		background: color-mix(in srgb, var(--surface-raised) 70%, transparent);
	}

	.site-footer-link {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		opacity: 0.9;
	}

	.site-footer-link:hover {
		opacity: 1;
	}

	.site-footer-logo {
		display: block;
		width: 1.5rem;
		height: 1.5rem;
		object-fit: contain;
	}
</style>
